# ========================================================
# PIA - Variables de Entorno para Servidor Institucional (Windows Server)
# Portal de Integridad Activa - Comisión Nacional contra la Corrupción (CNC)
# ========================================================

# 1. Configuración de Red y Proceso
# Puerto de escucha del servicio Node.js (exclusivo para 127.0.0.1 detrás de IIS Reverse Proxy)
PORT=3000
NODE_ENV=production

# 2. Almacenamiento Persistente Protegido
# Ruta física independiente fuera del DocumentRoot público de IIS (ej. C:\PIA_Data en Windows Server)
PIA_DATA_DIR=C:\PIA_Data

# 3. Google Gemini API (Asistente Virtual Lupita)
# Clave API generada en Google Cloud Console para el proyecto institucional.
# Si no está configurada, Lupita opera en modo contingencia con su motor de respuestas heurísticas oficiales.
# PENDIENTE: Proveer clave real por el equipo de TI institucional.
GEMINI_API_KEY=

# 4. Microsoft Entra ID (Autenticación Institucional Microsoft 365)
# PENDIENTE: ID del Arrendatario (Tenant ID) institucional de la CNC en Microsoft Azure / Entra ID.
ENTRA_TENANT_ID=
# PENDIENTE: ID de la Aplicación Cliente (Client ID) registrada como SPA en Microsoft Entra ID.
ENTRA_CLIENT_ID=
# URI de Redirección autorizada en Microsoft Entra ID para la interfaz administrativa.
ENTRA_REDIRECT_URI=https://pia.gob.gt/admin/

# 5. Identidades Operativas Autorizadas (Modelo Exclusivo para DOS Operadores)
# IMPORTANTE:
# - La autorización se valida EXCLUSIVAMENTE mediante el identificador inmutable de objeto (OID)
#   emitido en el token criptográfico JWT por Microsoft Entra ID para el tenant autorizado (TID).
# - Los correos (UPN) y nombres son únicamente referencias informativas de auditoría.
# - NUNCA ingresar contraseñas de Microsoft 365 en este archivo ni en el código.

# Operador 1: apoyogi@cnc.gob.gt
# PENDIENTE: Extraer el OID real (GUID) del usuario en Microsoft Entra ID.
PIA_OPERATOR_1_OID=
PIA_OPERATOR_1_UPN=apoyogi@cnc.gob.gt
PIA_OPERATOR_1_NAME=Apoyo GI (CNC)

# Operador 2: deteccionydenuncia@cnc.gob.gt
# PENDIENTE: Extraer el OID real (GUID) del usuario en Microsoft Entra ID.
PIA_OPERATOR_2_OID=
PIA_OPERATOR_2_UPN=deteccionydenuncia@cnc.gob.gt
PIA_OPERATOR_2_NAME=Detección y Denuncia (CNC)
